# Public DNS names pointing to this server.
GATEWAY_HOST=realtime.example.com
TURN_HOST=turn.example.com
TURN_REALM=turn.example.com

# Public IPv4 address of the server. TURN requires direct UDP/TCP reachability.
PUBLIC_IP=203.0.113.10

# Generate strong independent values before deployment.
CG_TOKEN_SECRET=replace-with-at-least-32-random-characters
CG_ALLOW_INSECURE_DEV=0
TURN_USERNAME=cernogram
TURN_PASSWORD=replace-with-a-long-random-password
