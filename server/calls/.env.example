# Public domains
LIVEKIT_DOMAIN=rtc.example.com
TURN_DOMAIN=turn.example.com
CALLS_API_DOMAIN=calls.example.com

# Pin these before production deployment
LIVEKIT_IMAGE=livekit/livekit-server:v1.12.0
COTURN_IMAGE=coturn/coturn:4.7.0

# Generate strong values. Never commit the real .env file.
LIVEKIT_API_KEY=replace_with_public_key_id
LIVEKIT_API_SECRET=replace_with_at_least_32_random_characters
CERNOGRAM_ACCESS_TOKEN_SECRET=replace_with_same_hmac_secret_as_realtime_auth
CERNOGRAM_CALL_TICKET_SECRET=replace_with_separate_32_char_call_ticket_secret
CERNOGRAM_CALL_TICKET_ISSUER_SECRET=replace_with_internal_issuer_secret
TURN_SHARED_SECRET=replace_with_separate_32_char_turn_secret

# Public server IP advertised by coturn. Required behind NAT.
TURN_EXTERNAL_IP=203.0.113.10

# Media ports
LIVEKIT_RTC_TCP_PORT=7881
LIVEKIT_RTC_UDP_START=50000
LIVEKIT_RTC_UDP_END=50100
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_RELAY_START=49160
TURN_RELAY_END=49260

# Certificates for TURN/TLS. Mount fullchain.pem and privkey.pem into ./certs.
TURN_CERT_FILE=/certs/fullchain.pem
TURN_KEY_FILE=/certs/privkey.pem

# Public WebSocket URL returned to clients.
LIVEKIT_PUBLIC_URL=wss://rtc.example.com

# Token lifetime in seconds.
CALL_TOKEN_TTL=300
CALL_TICKET_TTL=90

# Optional development mode. Never enable on a public server.
CG_CALLS_ALLOW_INSECURE_DEV=0
