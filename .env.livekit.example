# IP-адрес компьютера в локальной сети, доступный Android-устройству.
LIVEKIT_NODE_IP=192.168.1.20

# Для локального теста значения должны совпадать с infra/livekit/livekit.yaml.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_WS_URL=ws://192.168.1.20:7880

# Этим ключом приложение авторизуется в Python broker.
BROKER_SHARED_SECRET=replace-with-a-long-random-value
BROKER_CORS_ORIGIN=*
